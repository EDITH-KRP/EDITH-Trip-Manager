APP_NAME=EDITH-TRIP MANAGER
ENVIRONMENT=development
API_PREFIX=/api/v1
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_FOR_JWT_SECURITY
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Supabase / PostgreSQL Configuration
# 1. Sign up at https://supabase.com and create a project
# 2. In Supabase Dashboard -> Settings -> Database -> Connection string:
#    Direct (port 5432) or Pooler (port 6543):
# SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_DB_URL=

# Fallback: If SUPABASE_DB_URL is blank, the app runs locally on SQLite (data/edith.db)
LOCAL_DB_PATH=data/edith.db

# Bootstrap Administrator
ADMIN_NAME=Prajwal
ADMIN_EMAIL=prajwal@edith.travel
ADMIN_PASSWORD=Prajwal784

# Frontend Origin (for local dev with Live Server)
FRONTEND_ORIGIN=http://127.0.0.1:5500

# Indian DLT SMS Gateway (Fast2SMS / Msg91) - Optional
SMS_ENABLED=false
SMS_GATEWAY_URL=https://www.fast2sms.com/dev/bulkV2
SMS_GATEWAY_API_KEY=your_dlt_sms_api_key_here
SMS_SENDER_ID=EDTTRP
SMS_ENTITY_ID=your_principal_entity_id_here

# Cloudflare Zero Trust / Access (Optional in dev, enable in cloud prod)
CLOUDFLARE_ACCESS_ENABLED=false
CLOUDFLARE_ACCESS_AUD=your_cf_access_aud_tag
CLOUDFLARE_ACCESS_TEAM=your_team_name
